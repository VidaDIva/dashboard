# URL pública de la API Spring Boot (sin barra final).
# En desarrollo local:
# PUBLIC_API_URL=http://localhost:8080/api
# En producción (Cloudflare Tunnel):
# PUBLIC_API_URL=https://<tu-tunel>.trycloudflare.com/api
PUBLIC_API_URL=http://localhost:8080/api

# Opcional: si no se define, se deriva de PUBLIC_API_URL cambiando /api por /ws.
# PUBLIC_WS_URL=wss://<tu-tunel>.trycloudflare.com/ws

# Clave pública VAPID para Web Push (se genera una vez y va junto a la privada).
# PUBLIC_VAPID_PUBLIC_KEY=
