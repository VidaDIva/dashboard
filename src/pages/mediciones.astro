---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Picur | Mediciones"
  active="mediciones"
  eyebrow="MONITOREO"
  heading="Mediciones"
  subtitle="Historial de mediciones registradas por los sensores."
>

  <div id="error-banner" class="error-banner" style="display:none;">
    <span></span>
  </div>

  <section class="panel" id="panel-historial">

    <div class="panel-header">
      <div>
        <h2>Historial</h2>
        <p id="total-mediciones">0 mediciones registradas</p>
      </div>
    </div>

    <div class="table-container">

      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Estado</th>
            <th>Aceleración X</th>
            <th>Aceleración Y</th>
            <th>Aceleración Z</th>
            <th>Frecuencia</th>
            <th>RMS</th>
            <th>Inclinación</th>
            <th>Vibración</th>
            <th>Umbral</th>
            <th>Índice</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody id="tabla-mediciones"></tbody>
      </table>

    </div>

    <div class="pagination">
      <button id="btn-anterior" class="pag-btn" type="button">← Anterior</button>
      <span id="pagina-info" class="pag-info">Página 1 de 1</span>
      <button id="btn-siguiente" class="pag-btn" type="button">Siguiente →</button>
    </div>

  </section>

  <div id="empty-mediciones" class="empty" style="display:none;">
    <div class="empty-icon">📡</div>
    <h2>No hay mediciones</h2>
    <p>Cuando lleguen datos de los sensores aparecerán aquí.</p>
  </div>

  <script>
    import {
      obtenerMediciones,
      conectarWebSocket,
      formatearNumero,
      formatearFecha,
      etiquetaEstado,
      sufijoEstado,
    } from "../scripts/api.js";
    import type { Medicion, MensajeWebSocket } from "../scripts/tipos";

    const TAMANO = 20;

    const tabla = document.getElementById("tabla-mediciones")!;
    const total = document.getElementById("total-mediciones")!;
    const panel = document.getElementById("panel-historial")!;
    const vacio = document.getElementById("empty-mediciones")!;
    const btnAnterior = document.getElementById("btn-anterior") as HTMLButtonElement;
    const btnSiguiente = document.getElementById("btn-siguiente") as HTMLButtonElement;
    const paginaInfo = document.getElementById("pagina-info")!;

    let pagina = 0;
    let totalMediciones = 0;
    let totalPaginas = 0;
    let mediciones: Medicion[] = [];
    let wsEnLinea = false;

    function render(mediciones: Medicion[]) {
      if (!mediciones || mediciones.length === 0) {
        panel.style.display = "none";
        vacio.style.display = "block";
        return;
      }

      panel.style.display = "block";
      vacio.style.display = "none";

      total.textContent = `${totalMediciones} mediciones registradas`;
      paginaInfo.textContent =
        `Página ${pagina + 1} de ${Math.max(totalPaginas, 1)}`;

      btnAnterior.disabled = pagina <= 0;
      btnSiguiente.disabled = pagina >= totalPaginas - 1;

      tabla.innerHTML = mediciones
        .map(
          (m, index) => `
            <tr>
              <td class="number" data-label="#">${pagina * TAMANO + index + 1}</td>
              <td data-label="Estado">
                <span class="estado-badge badge-${sufijoEstado(m.estado)}">
                  ${etiquetaEstado(m.estado)}
                </span>
              </td>
              <td data-label="Aceleración X">${formatearNumero(m.aceleracionX)}</td>
              <td data-label="Aceleración Y">${formatearNumero(m.aceleracionY)}</td>
              <td data-label="Aceleración Z">${formatearNumero(m.aceleracionZ)}</td>
              <td data-label="Frecuencia">${formatearNumero(m.frecuencia)} Hz</td>
              <td data-label="RMS">${formatearNumero(m.rms)}</td>
              <td data-label="Inclinación">${formatearNumero(m.inclinacion)}°</td>
              <td data-label="Vibración">${formatearNumero(m.vibracion)}</td>
              <td data-label="Umbral">${formatearNumero(m.umbral)}</td>
              <td data-label="Índice">${formatearNumero(m.indiceAnomalia)}</td>
              <td data-label="Fecha">${formatearFecha(m.fechaRegistro)}</td>
            </tr>
          `
        )
        .join("");
    }

    async function cargar() {
      try {
        const datos = await obtenerMediciones({ pagina, tamano: TAMANO });
        totalMediciones = datos.totalElements || 0;
        totalPaginas = datos.totalPages || 0;
        mediciones = datos.content || [];
        window.marcarConexion(true);
        render(mediciones);
      } catch (error) {
        window.marcarConexion(
          false,
          error instanceof Error && error.message
            ? error.message
            : "Se perdió la conexión con la API"
        );
      }
    }

    function irAPagina(nueva: number) {
      if (nueva < 0 || nueva >= totalPaginas) return;
      pagina = nueva;
      cargar();
    }

    btnAnterior.addEventListener("click", () => irAPagina(pagina - 1));
    btnSiguiente.addEventListener("click", () => irAPagina(pagina + 1));

    conectarWebSocket({
      alMensaje: (mensaje: MensajeWebSocket) => {
        if (!mensaje || mensaje.tipo !== "MEDICION" || !mensaje.datos) return;

        const m = mensaje.datos;
        totalMediciones += 1;
        totalPaginas = Math.max(1, Math.ceil(totalMediciones / TAMANO));

        if (pagina === 0 && !mediciones.some((x) => x.id === m.id)) {
          mediciones.unshift(m);
          while (mediciones.length > TAMANO) mediciones.pop();
          render(mediciones);
        } else {
          total.textContent = `${totalMediciones} mediciones registradas`;
        }
      },
      alCambiarEstado: (online: boolean) => {
        wsEnLinea = online;
        window.marcarConexion(
          online,
          "Se perdió la conexión en tiempo real con la API"
        );
      },
    });

    cargar();

    // Respaldo: si el WebSocket está caído, sincroniza por polling.
    setInterval(() => {
      if (!wsEnLinea) cargar();
    }, 15000);
  </script>

</Layout>