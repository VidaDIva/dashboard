---
import "../styles/global.css";
import RegistroPWA from "../components/RegistroPWA.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#111827" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Picur" />
    <title>Picur | Restablecer contraseña</title>
  </head>

  <body class="auth-page">

    <div class="auth-card">

      <div class="auth-logo">
        <div class="logo-icon">P</div>
        <span>Picur</span>
      </div>

      <h1>Nueva contraseña</h1>

      <p class="auth-subtitle">
        Ingresa el código que recibiste y define tu nueva contraseña.
      </p>

      <div id="auth-error" class="auth-error" style="display:none;"></div>

      <form id="restablecer-form" class="auth-form">

        <div class="form-group">
          <label class="form-label" for="codigo">Código de verificación</label>
          <input
            class="form-input form-codigo"
            type="text"
            id="codigo"
            name="codigo"
            pattern="[0-9]{6}"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            placeholder="000000"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="nuevaContrasena">Nueva contraseña</label>
          <input
            class="form-input"
            type="password"
            id="nuevaContrasena"
            name="nuevaContrasena"
            placeholder="••••••••"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmarContrasena">Confirmar contraseña</label>
          <input
            class="form-input"
            type="password"
            id="confirmarContrasena"
            name="confirmarContrasena"
            placeholder="••••••••"
            autocomplete="new-password"
            minlength="6"
            required
          />
        </div>

        <button class="btn btn-primary btn-block" type="submit">
          Restablecer contraseña
        </button>

      </form>

      <p class="auth-link">
        ¿No llegó el código?
        <a href="/recuperar">Solicítalo de nuevo</a>
      </p>

    </div>

    <script>
      import { restablecerContrasena } from "../scripts/api.js";

      const formulario = document.getElementById("restablecer-form")!;
      const errorBox = document.getElementById("auth-error")!;
      const boton = formulario.querySelector("button")!;

      formulario.addEventListener("submit", async (evento) => {
        evento.preventDefault();

        errorBox.style.display = "none";

        const contacto = new URLSearchParams(window.location.search).get("contacto") || "";
        const codigo = (document.getElementById("codigo") as HTMLInputElement).value.trim();
        const nuevaContrasena = (document.getElementById("nuevaContrasena") as HTMLInputElement).value;
        const confirmar = (document.getElementById("confirmarContrasena") as HTMLInputElement).value;

        if (nuevaContrasena !== confirmar) {
          errorBox.textContent = "Las contraseñas no coinciden";
          errorBox.style.display = "block";
          return;
        }

        if (!contacto) {
          errorBox.textContent = "Falta el correo. Vuelve a solicitar el código.";
          errorBox.style.display = "block";
          return;
        }

        boton.disabled = true;
        boton.textContent = "Guardando...";

        try {
          await restablecerContrasena(contacto, codigo, nuevaContrasena);

          localStorage.removeItem("picur_sesion");
          window.location.href = "/login?recuperada=1";
        } catch (error) {
          errorBox.textContent =
            error instanceof Error ? error.message : "No se pudo restablecer la contraseña";
          errorBox.style.display = "block";
        } finally {
          boton.disabled = false;
          boton.textContent = "Restablecer contraseña";
        }
      });
    </script>

    <RegistroPWA />
  </body>
</html>