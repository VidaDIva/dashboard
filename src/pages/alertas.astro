---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Picur | Alertas"
  active="alertas"
  eyebrow="SEGURIDAD"
  heading="Alertas"
  subtitle="Eventos detectados en las mediciones de los sensores."
>

  <div id="error-banner" class="error-banner" style="display:none;">
    <span></span>
  </div>

  <section class="alert-summary">

    <div class="summary-card">
      <span class="summary-label">Total de alertas</span>
      <strong id="total-alertas">0</strong>
    </div>

    <div class="summary-card critical">
      <span class="summary-label">Críticas</span>
      <strong id="total-criticas">0</strong>
    </div>

    <div class="summary-card warning">
      <span class="summary-label">Advertencias</span>
      <strong id="total-advertencias">0</strong>
    </div>

  </section>

  <section class="alerts-container" id="alertas-contenedor" style="display:none;"></section>

  <div id="alertas-vacio" class="empty" style="display:flex;">
    <div class="empty-icon">✓</div>
    <h2>Todo está normal</h2>
    <p>No se han detectado valores fuera de los límites establecidos.</p>
  </div>

  <script>
    import { obtenerMediciones, formatearNumero } from "../scripts/api.js";

    const contenedor = document.getElementById("alertas-contenedor");
    const vacio = document.getElementById("alertas-vacio");
    const total = document.getElementById("total-alertas");
    const criticas = document.getElementById("total-criticas");
    const advertencias = document.getElementById("total-advertencias");

    function calcularAlertas(mediciones) {
      const alertas = [];

      for (const medicion of mediciones) {
        if (medicion.rms > 4) {
          alertas.push({
            tipo: "CRITICA",
            titulo: "RMS elevado",
            mensaje: `El valor RMS es ${formatearNumero(medicion.rms)} m/s²`,
            valor: formatearNumero(medicion.rms),
          });
        }

        if (medicion.frecuencia > 100) {
          alertas.push({
            tipo: "ADVERTENCIA",
            titulo: "Frecuencia elevada",
            mensaje: `La frecuencia alcanzó ${formatearNumero(medicion.frecuencia)} Hz`,
            valor: formatearNumero(medicion.frecuencia),
          });
        }

        if (Math.abs(medicion.inclinacion) > 10) {
          alertas.push({
            tipo: "ADVERTENCIA",
            titulo: "Inclinación elevada",
            mensaje: `La inclinación alcanzó ${formatearNumero(medicion.inclinacion)}°`,
            valor: formatearNumero(medicion.inclinacion),
          });
        }
      }

      return alertas;
    }

    function render(mediciones) {
      const alertas = calcularAlertas(mediciones || []);

      total.textContent = alertas.length;
      criticas.textContent = alertas.filter((a) => a.tipo === "CRITICA").length;
      advertencias.textContent = alertas.filter((a) => a.tipo === "ADVERTENCIA").length;

      if (alertas.length === 0) {
        contenedor.style.display = "none";
        vacio.style.display = "flex";
        return;
      }

      contenedor.style.display = "flex";
      vacio.style.display = "none";

      contenedor.innerHTML = alertas
        .map(
          (alerta) => `
            <div class="alert ${alerta.tipo === "CRITICA" ? "alert-critical" : "alert-warning"}">
              <div class="alert-icon">${alerta.tipo === "CRITICA" ? "!" : "⚠"}</div>
              <div class="alert-content">
                <div class="alert-top">
                  <span class="alert-type">${alerta.tipo}</span>
                  <span class="alert-value">${alerta.valor}</span>
                </div>
                <h2>${alerta.titulo}</h2>
                <p>${alerta.mensaje}</p>
              </div>
            </div>
          `
        )
        .join("");
    }

    async function cargar() {
      try {
        const mediciones = await obtenerMediciones();
        window.marcarConexion(true);
        render(mediciones);
      } catch (error) {
        window.marcarConexion(
          false,
          error.message || "Se perdió la conexión con la API"
        );
      }
    }

    cargar();
    setInterval(cargar, 5000);
  </script>

</Layout>