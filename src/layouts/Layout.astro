---
import "../styles/global.css";
import AsistenteLlavero from "../components/AsistenteLlavero.astro";
import RegistroPWA from "../components/RegistroPWA.astro";

interface Props {
  title?: string;
  active?: "dashboard" | "mediciones" | "alertas" | "recomendaciones";
  eyebrow?: string;
  heading?: string;
  subtitle?: string;
}

const {
  title = "Picur | Dashboard",
  active = "dashboard",
  eyebrow = "MONITOREO",
  heading = "Dashboard",
  subtitle = "",
} = Astro.props;

const enlaces = [
  { clave: "dashboard", href: "/", icono: "▦", etiqueta: "Dashboard" },
  { clave: "mediciones", href: "/mediciones", icono: "◉", etiqueta: "Mediciones" },
  { clave: "alertas", href: "/alertas", icono: "⚠", etiqueta: "Alertas" },
  { clave: "recomendaciones", href: "/recomendaciones", icono: "✦", etiqueta: "Asistente" },
] as const;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#111827" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Picur" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="dashboard">

      <aside class="sidebar">

        <div class="logo">
          <div class="logo-icon">P</div>
          <span>Picur</span>
        </div>

        <nav aria-label="Navegación principal">
          {
            enlaces.map((enlace) => (
              <a
                href={enlace.href}
                class:list={[active === enlace.clave && "active"]}
                aria-current={active === enlace.clave ? "page" : undefined}
              >
                <span aria-hidden="true">{enlace.icono}</span>
                {enlace.etiqueta}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-bottom">
          <div data-user-name class="user-greeting"></div>

          <div class="status">
            <span class="status-dot"></span>
            Sistema conectado
          </div>

          <button class="btn-salir" type="button" data-logout>
            Salir
          </button>
        </div>

      </aside>

      <header class="mobile-topbar">

        <a class="mobile-logo" href="/" aria-label="Picur, ir al inicio">
          <span class="logo-icon">P</span>
          <span>Picur</span>
        </a>

        <div class="mobile-actions">
          <span data-user-name class="user-greeting-movil"></span>
          <button class="btn-salir-movil" type="button" data-logout>
            Salir
          </button>
        </div>

      </header>

      <main class="main">

        <header class="header">

          <div>
            <p class="eyebrow">{eyebrow}</p>

            <h1>{heading}</h1>

            <p class="subtitle">
              {subtitle}
            </p>
          </div>

          <div class="connection" id="connection-status">
            <span id="conn-dot" class="status-dot"></span>
            <span id="conn-text">API conectada</span>
          </div>

        </header>

        <slot />

      </main>

      <nav class="mobile-nav" aria-label="Navegación principal">
        {
          enlaces.map((enlace) => (
            <a
              href={enlace.href}
              class:list={[active === enlace.clave && "active"]}
              aria-current={active === enlace.clave ? "page" : undefined}
            >
              <span class="mobile-nav-icon" aria-hidden="true">{enlace.icono}</span>
              <span class="mobile-nav-label">{enlace.etiqueta}</span>
            </a>
          ))
        }
      </nav>

    </div>

    <script>
      import { cerrarSesion, obtenerSesion } from "../scripts/api.js";

      const sesion = obtenerSesion();

      // Guard de sesión: sin sesión → login
      if (!sesion) {
        window.location.replace("/login");
      }

      const saludos = document.querySelectorAll("[data-user-name]");
      if (sesion) {
        const texto = sesion.nombre
          ? `Hola, ${sesion.nombre}`
          : "Sesión iniciada";
        saludos.forEach((saludo) => {
          saludo.textContent = texto;
        });
      }

      document.querySelectorAll("[data-logout]").forEach((botonSalir) => {
        botonSalir.addEventListener("click", () => {
          cerrarSesion();
          window.location.href = "/login";
        });
      });

      // Helper compartido para actualizar el estado de conexión de la API
      window.marcarConexion = (ok: boolean, mensaje = "Se perdió la conexión con la API") => {
        const punto = document.getElementById("conn-dot");
        const texto = document.getElementById("conn-text");
        const estado = document.getElementById("connection-status");

        if (punto) punto.className = "status-dot " + (ok ? "ok" : "bad");
        if (texto) texto.textContent = ok ? "API conectada" : "Sin conexión";
        if (estado) estado.className = "connection " + (ok ? "online" : "offline");

        const banner = document.getElementById("error-banner");
        if (banner) {
          banner.style.display = ok ? "none" : "block";
          if (!ok) {
            const textoBanner = banner.querySelector("span");
            if (textoBanner) textoBanner.textContent = mensaje;
          }
        }
      };
    </script>

    <AsistenteLlavero />
    <RegistroPWA />
  </body>
</html>